page { background: #f8fafc; color: #0f172a; }
.container { padding: 24rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 10rpx rgba(15,23,42,.06); }
.title { font-size: 32rpx; font-weight: 600; margin-bottom: 12rpx; }
.row { display: flex; align-items: center; justify-content: space-between; margin: 8rpx 0; }
.label { color: #64748b; }
.value { font-weight: 600; }
.input { border: 1rpx solid #cbd5e1; border-radius: 12rpx; padding: 16rpx; margin: 10rpx 0; background: #fff; }
.btn { margin-top: 14rpx; }
